filters:
  and:
    - file.hasTag("都電停留場")
    - 対象年月 == "1958-09"
formulas:
  系統数: 路線.unique().length
properties:
  file.name:
    displayName: 停留場ノート
  停留場名:
    displayName: 停留場
  よみ:
    displayName: よみ
  路線:
    displayName: 通る系統
  formula.系統数:
    displayName: 系統数
  資料表記:
    displayName: 資料の表記
views:
  - type: table
    name: すべての停留場
    order:
      - 停留場名
      - file.name
      - よみ
      - 路線
      - formula.系統数
      - 資料表記
    sort:
      - property: formula.系統数
        direction: DESC
      - property: よみ
        direction: ASC
  - type: table
    name: 乗換・共通停留場
    filters:
      and:
        - formula.系統数 > 1
    order:
      - 停留場名
      - file.name
      - 路線
      - formula.系統数
    sort:
      - property: formula.系統数
        direction: DESC
      - property: よみ
        direction: ASC
  - type: table
    name: 1系統だけの停留場
    filters:
      and:
        - formula.系統数 == 1
    order:
      - 停留場名
      - file.name
      - 路線
    sort:
      - property: よみ
        direction: ASC
  - type: table
    name: 1系統
    filters:
      and:
        - 系統番号.contains(1)
    order:
      - 01系統順
      - 停留場名
      - file.name
      - 路線
      - formula.系統数
    sort:
      - property: 01系統順
        direction: ASC
  - type: table
    name: 2系統
    filters:
      and:
        - 系統番号.contains(2)

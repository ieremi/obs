filters:
  and:
    - file.hasTag("book")
formulas:
  amazon: link("https://www.amazon.co.jp/s?k=" + isbn.replace(/-/g, ""), "Amazon")
properties:
  file.name:
    displayName: ノート
  title:
    displayName: タイトル
  author:
    displayName: 著者
  translator:
    displayName: 訳者
  label:
    displayName: レーベル
  publisher:
    displayName: 出版社
  published:
    displayName: 刊行日
  list_price:
    displayName: 定価
  list_price_current:
    displayName: 現在の定価
  amazon_used_price_minimum:
    displayName: 中古最安値
  amazon_used_price_checked:
    displayName: 中古価格の確認日
  used_available:
    displayName: 中古でかえる
  ebook_available:
    displayName: 電子版
  unavailable:
    displayName: うっていない
  expensive:
    displayName: たかい
  new_available:
    displayName: 新品でかえる
  pdf:
    displayName: pdf
  my_era:
    displayName: 自分の時代
  subject:
    displayName: 科目など
  size:
    displayName: サイズ
  keep:
    displayName: とっておく？
  destination:
    displayName: ゆきさき
  paper:
    displayName: 紙
  formula.amazon:
    displayName: Amazon
views:
  - type: table
    name: すべての本
    order:
      - file.name
      - author
      - subject
      - list_price
      - amazon_used_price_minimum
      - used_available
      - expensive
      - new_available
      - ebook_available
      - pdf
      - my_era
      - keep
      - destination
      - paper
      - size
      - formula.amazon
    sort:
      - property: size
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.paper: 113
  - type: table
    name: 新品でかえる
    filters:
      and:
        - new_available == true
    order:
      - file.name
      - list_price_current
      - amazon_used_price_minimum
      - ebook_available
    sort:
      - property: amazon_used_price_minimum
        direction: ASC
  - type: table
    name: ゆきさき：スキャン業者
    filters:
      and:
        - destination == "スキャン業者"
    order:
      - file.name
      - author
      - subject
      - pdf
      - keep
      - paper
      - size
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: ゆきさき：みずからきる
    filters:
      and:
        - destination == "みずからきる"
    order:
      - file.name
      - author
      - subject
      - pdf
      - keep
      - paper
      - size
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: ゆきさき：スキャンしない
    filters:
      and:
        - destination == "スキャンしない"
    order:
      - file.name
      - author
      - subject
      - pdf
      - keep
      - paper
      - size
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: ゆきさき：すてる
    filters:
      and:
        - destination == "すてる"
    order:
      - file.name
      - author
      - subject
      - pdf
      - keep
      - paper
      - size
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 中古でもかえない
    filters:
      and:
        - used_available == false
    order:
      - file.name
      - author
      - subject
      - publisher
      - published
      - pdf
      - keep
      - destination
    sort:
      - property: file.name
        direction: ASC

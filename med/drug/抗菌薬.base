filters:
  or:
    - file.hasTag("drug/antibiotic", "drug/antibiotic/penicillin", "drug/antibiotic/cephalosporin", "drug/antibiotic/beta-lactamase-inhibitor", "drug/antibiotic/macrolide")
formulas:
  lineage: if(file.hasTag("drug/antibiotic/penicillin"), "ペニシリン系", if(file.hasTag("drug/antibiotic/cephalosporin"), "セフェム系", if(file.hasTag("drug/antibiotic/beta-lactamase-inhibitor"), "β-ラクタマーゼ阻害薬", if(file.hasTag("drug/antibiotic/macrolide"), "マクロライド系", "その他"))))
  brand_jp: brand_names.jp
  pubchem: if(pubchem_cid, link("https://pubchem.ncbi.nlm.nih.gov/compound/" + pubchem_cid, pubchem_cid.toString()), "")
properties:
  file.name:
    displayName: ノート
  generic_name_en:
    displayName: 英名
  drug_class:
    displayName: 分類
  routes:
    displayName: 投与経路
  formula.lineage:
    displayName: 系統
  formula.brand_jp:
    displayName: 商品名(日本)
  formula.pubchem:
    displayName: PubChem
views:
  - type: table
    name: すべての抗菌薬
    order:
      - file.name
      - formula.lineage
      - generic_name_en
      - drug_class
      - routes
      - formula.brand_jp
      - formula.pubchem
    sort:
      - property: formula.lineage
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: 経口薬
    filters:
      and:
        - routes.contains("経口")
    order:
      - file.name
      - formula.lineage
      - generic_name_en
      - drug_class
      - formula.brand_jp
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 注射薬
    filters:
      or:
        - routes.contains("静注")
        - routes.contains("点滴静注")
        - routes.contains("筋注")
    order:
      - file.name
      - formula.lineage
      - generic_name_en
      - drug_class
      - routes
      - formula.brand_jp
    sort:
      - property: formula.lineage
        direction: ASC
      - property: file.name
        direction: ASC

filters:
  and:
    - file.inFolder("history/world/イスラーム王朝")
    - file.ext == "md"
properties:
  英語名:
    displayName: 英語名
  時代と地域:
    displayName: とき・ところ
  成立:
    displayName: はじまりかた
  終焉:
    displayName: おわりかた
  成果:
    displayName: よかったところ
  課題:
    displayName: わるかったところ
  人物:
    displayName: おもな人物
  事物:
    displayName: おもな事物・出来事
views:
  - type: table
    name: イスラーム王朝一覧
    order:
      - file.name
      - 英語名
      - 時代と地域
      - 成立
      - 終焉
      - 成果
      - 課題
      - 人物
      - 事物
